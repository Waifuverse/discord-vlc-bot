# Public, blank configuration template. Do not put real credentials in this file.
# Run setup.ps1 to generate your private .env, then edit .env instead.

# Required: Discord Bot page > token (without a "Bot " prefix).
DISCORD_TOKEN=
# Required: enable Developer Mode in Discord, then copy server/channel IDs.
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
# Optional: user who can create the panel and lock/unlock controls.
# Members with Manage Server already have host access.
HOST_USER_ID=
# Optional: restrict controls to this role; blank allows everyone in the channel.
CONTROL_ROLE_ID=

# Relative to this project, or an absolute local directory (forward slashes work).
# For example: MEDIA_ROOT=C:/Videos/Shows
MEDIA_ROOT=media

# Keep VLC control on this PC. Setup generates a unique password in .env.
VLC_URL=http://127.0.0.1:8080
VLC_PASSWORD=
